---
// Replaces Starlight's site title with the learnshelf mark and the course's name, one link to the course's home page.
import mark from '../assets/learnshelf-mark.svg';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
    <img src={mark.src} width={mark.width} height={mark.height} alt="learnshelf" />
    <span>{siteTitle}</span>
</a>

<style>
    .site-title {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        min-width: 0;
        color: var(--sl-color-white);
        font-size: 1.25rem;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
    }
    img {
        height: 24px;
        width: auto;
        flex: none;
    }
    span {
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>
